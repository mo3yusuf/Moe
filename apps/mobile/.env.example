# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are embedded in the app bundle — they are PUBLIC.
# Only ever put the Supabase ANON key here (protected by row-level security), never the service role key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# CRAVE API (services/api). On a physical device use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
