# CRAVE mobile — copy to apps/mobile/.env.local. EXPO_PUBLIC_* values are bundled
# into the app and are PUBLIC by design. Never put secret keys here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# CRAVE API base URL. On a physical device use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
