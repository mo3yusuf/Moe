# Copy to apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# CRAVE API used for privileged operations (orders, refunds). Server-side only.
CRAVE_API_URL=http://127.0.0.1:8787
# Crash reporting via sentry.io (optional): SENTRY_DSN for the server, NEXT_PUBLIC_SENTRY_DSN for browsers
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Address search on restaurant sign-up uses free OpenStreetMap (Photon) by default. Optional upgrade to
# Google Places API (New) — server-only key. ADDRESS_SEARCH=off disables the search box.
# GOOGLE_MAPS_API_KEY=
