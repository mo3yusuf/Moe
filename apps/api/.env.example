# CRAVE API — copy to apps/api/.env (never commit real values)
PORT=8787
# Direct Postgres connection string (Supabase → Project Settings → Database). Server-side ONLY.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Legacy HS256 JWT secret (local `supabase start` prints it). If unset, the API verifies tokens via the project's JWKS.
SUPABASE_JWT_SECRET=
# Service role key — used ONLY for auth admin operations (account deletion). Never ship to clients.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated allowed origins for the web dashboard
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
