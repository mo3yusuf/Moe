{
  "name": "@crave/api",
  "version": "0.1.0",
  "private": true,
  "description": "CRAVE backend service: feed ranking, interaction ingestion, taste profiles, (later) orders & payments.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "npm run test:db",
    "test:db": "bash ../../scripts/db-local-reset.sh && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crave/core": "*",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
