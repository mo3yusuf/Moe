# Copy to services/api/.env — never commit the real file.
NODE_ENV=development
PORT=8787
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-anon-key
# SERVER ONLY. Grants full database access. Never put this in the mobile app or web client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Stripe (Phase 7). Use test keys (sk_test_...) until Stripe Connect is approved.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
